# Your Clash of Clans API key (create it at developer.clashofclans.com with allowed IP 45.79.218.79)
COC_API_KEY=paste-your-key-here

# Password needed to add or remove clans and to set join dates. Share it only with people you trust.
ADMIN_PASSWORD=choose-a-strong-password

# Optional: your domain, for automatic HTTPS. Leave this line out entirely if you have no domain yet.
# DOMAIN=clans.example.com

# Optional tuning
# MAX_CLANS=20
# SYNC_MINUTES=60
# SYNC_COOLDOWN=300
